<launch>

  <!-- gridmap -> map relay -->
  <!-- <node pkg="topic_tools" type="relay" name="gridmap_to_map"
        args="/hdl_global_localization/bbs/gridmap /map" output="screen" /> -->

  <arg name="map_file" default="$(find navigation_stack)/maps/gachon.yaml"/>
  <node pkg="map_server" type="map_server" name="map_server" args="$(arg map_file)">
    <param name="frame_id" value="map"/>
  </node>

  <!-- Move Base Node -->
  <node pkg="move_base" type="move_base" respawn="false" name="move_base" output="screen">
    
    <!-- Costmap Common Parameters -->
    <rosparam file="$(find navigation_stack)/config/costmap_common_params.yaml" command="load" ns="global_costmap" />
    <rosparam file="$(find navigation_stack)/config/costmap_common_params.yaml" command="load" ns="local_costmap" />
    
    <!-- Costmap Specific Parameters -->
    <rosparam file="$(find navigation_stack)/config/global_costmap_params.yaml" command="load" />
    <rosparam file="$(find navigation_stack)/config/local_costmap_params.yaml" command="load" />
    
    <!-- Move Base Behavior Parameters -->
    <rosparam file="$(find navigation_stack)/config/move_base_params.yaml" command="load" />
    
    <!-- Planner Parameters -->
    <rosparam file="$(find navigation_stack)/config/global_planner_params.yaml" command="load" />
    <rosparam file="$(find navigation_stack)/config/teb_local_planner_params.yaml" command="load" />
    
    <!-- Planner Selection -->
    <param name="base_global_planner" value="global_planner/GlobalPlanner"/>
    <param name="base_local_planner" value="teb_local_planner/TebLocalPlannerROS"/>
    
    <!-- Topic Remapping -->
  </node>

  <node pkg="rviz" type="rviz" name="move_base_rviz"
      args="-d $(find navigation_stack)/rviz/navigation.rviz" />


</launch>