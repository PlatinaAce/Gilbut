<launch>
  <!-- CARLA Ackermann Control to Diff Drive Converter -->
  <node pkg="navigation_stack" type="cmd_vel_to_ackermann.py" name="cmd_vel_to_ackermann" output="screen">
    <remap from="/cmd_vel" to="/carla/ego_vehicle/cmd_vel"/>
    <remap from="/ackermann_cmd" to="/carla/ego_vehicle/ackermann_cmd"/>
    
    <!-- Vehicle parameters -->
    <param name="wheelbase" value="2.85"/>  <!-- CARLA 차량 축거 -->
    <param name="max_steer_angle" value="0.7"/>  <!-- 최대 조향각 (라디안) -->
  </node>
</launch>